{
  "expo": {
    "name": "ConectaUCE",
    "slug": "conectauce",
    "scheme": "conectauce",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ec.edu.uce.conectauce"
    },
    "android": {
      "package": "ec.edu.uce.conectauce",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#182D4D"
      }
    },
    "icon": "./assets/icon.png"
  }
}
