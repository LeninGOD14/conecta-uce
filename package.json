{
  "name": "conectauce-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/desktop",
    "packages/contracts"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @conectauce/web",
    "build:web": "npm run build --workspace @conectauce/web",
    "dev:mobile": "npm run start --workspace @conectauce/mobile",
    "typecheck:web": "npm run typecheck --workspace @conectauce/web",
    "typecheck:mobile": "npm run typecheck --workspace @conectauce/mobile",
    "dev:desktop": "npm run tauri --workspace @conectauce/desktop-shell -- dev",
    "build:desktop": "npm run tauri --workspace @conectauce/desktop-shell -- build"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  }
}
